#include <iostream> #include <cmath> using namespace std;  void DDA(int x1, int y1, int x2, int y2) {     int dx = x2 - x1, dy = y2 - y1;     int steps = max(abs(dx), abs(dy));      float x = x1, y = y1;     float xinc = dx / (float)steps;     float yinc = dy / (float)steps;      for (int i = 0; i <= steps; i++)     {         cout << "(" << round(x) << "," << round(y) << ")" << endl;         x += xinc;         y += yinc;     } }  int main() {     DDA(2, 2, 10, 6);     return 0; } #include <iostream> #include <cmath> using namespace std;  int main() {     int x1=2,y1=2,x2=8,y2=5;     int dx=abs(x2-x1), dy=abs(y2-y1);     int sx=(x1<x2)?1:-1, sy=(y1<y2)?1:-1;     int err=dx-dy;      while (true) {         cout<<"("<<x1<<","<<y1<<")\n";         if (x1==x2 && y1==y2) break;         int e2=2*err;         if (e2>-dy){ err-=dy; x1+=sx; }         if (e2< dx){ err+=dx; y1+=sy; }     }     return 0; }    #include <iostream> using namespace std;  void circle(int r) {     int x = 0, y = r, p = 3 - 2 * r;      while (x <= y) {         cout << "(" << x << "," << y << ") "              << "(" << y << "," << x << ") "              << "(" << -x << "," << y << ") "              << "(" << -y << "," << x << ") "              << "(" << -x << "," << -y << ") "              << "(" << -y << "," << -x << ") "              << "(" << x << "," << -y << ") "              << "(" << y << "," << -x << ")\n";          if (p < 0)             p += 4 * x + 6;         else {             p += 4 * (x - y) + 10;             y--;         }         x++;     } }  int main() {     circle(5);     return 0; } 
